#!name=🐰 YumikoToys NIO-Dash 凭证直推
#!desc=自动拦截蔚来 App 请求，提取 Token / VehicleID 并直推到 YumikoToys App（127.0.0.1:8997），全程无需手动复制。
#!author=YumikoToys
#!homepage=https://github.com/kissggj123/NIO-Dash-iOS
#!icon=https://raw.githubusercontent.com/kissggj123/NIO-Dash-iOS/main/wheater/Assets.xcassets/AppIcon.appiconset/icon_60%402x.png
#!category=车联网

[Script]
# 蔚来 API 凭证嗅探 & 直推 YumikoToys App
NIO-Credential-Push = type=http-request, pattern=^https?://(.*\.)?nio\.com, requires-body=false, max-size=0, script-path=https://raw.githubusercontent.com/kissggj123/NIO-Dash-iOS/main/scripts/shadowrocket/nio_credential_push.js, script-update-interval=86400

[MITM]
hostname = *.nio.com, nio.com, gateway-front-external.nio.com, icar.nio.com, app.nio.com, account.nio.com
